[Unit]
Description=ProtonVPN WireGuard rotator HTTP API
Documentation=https://github.com/marclloydjolly/proton-wg-rotator
After=network.target

[Service]
Type=simple
# Must run as root: needs to read /etc/wireguard/, call `wg show`, and
# `systemctl start protonwg-*.service` on behalf of frontend actions.
User=root
WorkingDirectory=REPLACE_WITH_PROJECT_ROOT

# Loopback bind (safe default; no auth needed; only same-host processes can reach it):
#   ExecStart=REPLACE_WITH_PROJECT_ROOT/.venv/bin/protonwg api --bind-host 127.0.0.1 --bind-port 8787
#
# LAN bind (bearer token required, auto-generated in state/api-token):
#   ExecStart=REPLACE_WITH_PROJECT_ROOT/.venv/bin/protonwg api --bind-host <YOUR_LAN_IP> --bind-port 8787
#
# All interfaces including any VPN tunnels — 0.0.0.0 (bearer token required):
#   ExecStart=REPLACE_WITH_PROJECT_ROOT/.venv/bin/protonwg api --bind-host 0.0.0.0 --bind-port 8787
ExecStart=REPLACE_WITH_PROJECT_ROOT/.venv/bin/protonwg api --bind-host 127.0.0.1 --bind-port 8787

Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
