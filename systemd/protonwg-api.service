[Unit]
Description=ProtonVPN WireGuard rotator HTTP API
Documentation=https://github.com/marclloydjolly/proton-wg-rotator
After=network.target

[Service]
Type=simple
# Must run as root: needs to read /etc/wireguard/, call `wg show`, and
# `systemctl start protonwg-*.service` on behalf of frontend actions.
User=root
WorkingDirectory=REPLACE_WITH_PROJECT_ROOT
ExecStart=REPLACE_WITH_PROJECT_ROOT/.venv/bin/protonwg api --bind-host 127.0.0.1 --bind-port 8787
Restart=on-failure
RestartSec=5s
# Long-running: do NOT set TimeoutStartSec; we want systemd to consider it
# started as soon as ExecStart runs, and it stays up forever.
StandardOutput=journal
StandardError=journal

# Uncomment to bind to the LAN instead of loopback. Only do this if you've
# put an auth layer in front (reverse proxy with basic auth, mTLS, etc.):
#   ExecStart=…/protonwg api --bind-host 0.0.0.0 --bind-port 8787

[Install]
WantedBy=multi-user.target
