[Unit]
Description=ProtonVPN WireGuard hot-loop (every 5 min)
Documentation=https://github.com/marclloydjolly/proton-wg-rotator

[Timer]
# Every 5 minutes on the wall clock (e.g. 12:00, 12:05, …) with up to
# 30s jitter so many installs don't hit Proton simultaneously.
OnCalendar=*:0/5
RandomizedDelaySec=30s
Persistent=false
Unit=protonwg-swap-check.service

[Install]
WantedBy=timers.target
